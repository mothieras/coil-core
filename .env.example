# Credentials for the default Anthropic provider or an Anthropic-compatible gateway.
# Other COIL_LLM_PROVIDER values use their own pi-ai credentials.
ANTHROPIC_API_KEY=sk-ant-xxx

# Model ID (required; ANTHROPIC_MODEL is a legacy alias)
MODEL_ID=claude-sonnet-4-6

# Provider id (optional). Defaults to "anthropic". Any pi-ai built-in provider works:
# openai, google, openrouter, zai, moonshotai, minimax, deepseek, ...
# COIL_LLM_PROVIDER=anthropic

# Optional fallback model ID, resolved under the same provider.
# FALLBACK_MODEL_ID=your-fallback-model

# Base URL (optional; only used with COIL_LLM_PROVIDER=anthropic)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Anthropic-compatible gateway examples
# Keep COIL_LLM_PROVIDER=anthropic and use the gateway key as ANTHROPIC_API_KEY.

# ---- International ----

# MiniMax          https://www.minimax.io
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# MODEL_ID=MiniMax-M2.5

# GLM (Zhipu)      https://z.ai
# ANTHROPIC_BASE_URL=https://z.ai/api/anthropic
# MODEL_ID=glm-5

# Kimi (Moonshot)  https://platform.moonshot.ai
# ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic
# MODEL_ID=kimi-k2.5

# DeepSeek         https://platform.deepseek.com
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-chat

# ---- China mainland ----

# MiniMax          https://platform.minimax.io
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# MODEL_ID=MiniMax-M2.5

# GLM (Zhipu)      https://open.bigmodel.cn
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# MODEL_ID=glm-5

# Kimi (Moonshot)  https://platform.moonshot.cn
# ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
# MODEL_ID=kimi-k2.5

# DeepSeek (no regional split, same endpoint globally)
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-chat
