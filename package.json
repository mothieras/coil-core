{
  "name": "coil-core",
  "version": "0.1.0",
  "description": "An embeddable local-first coding agent engine — small trusted core, MCP, subagents, observable execution, and reports. Ships with an Ink TUI.",
  "main": "./dist/core/index.js",
  "bin": {
    "coil-core": "./dist/main.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/main.ts",
    "dev:watch": "tsx watch src/main.ts",
    "test": "tsx --test \"tests/**/*.test.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "build": "pnpm clean && tsc",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "coding-agent",
    "agent",
    "cli",
    "tui",
    "llm",
    "anthropic",
    "mcp",
    "ink"
  ],
  "author": "mothieras",
  "license": "MIT",
  "packageManager": "pnpm@11.0.9",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.17",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "dotenv": "^17.4.2",
    "ink": "^7.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^18.0.5",
    "marked-terminal": "^7.3.0",
    "react": "^19.2.0",
    "string-width": "^8.2.2"
  }
}
